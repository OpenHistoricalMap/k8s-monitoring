    {
      "id": 102,
      "type": "timeseries",
      "title": "Requests per day by client, top 10 (only requests Cloudflare let through)",
      "description": "Classified from the User-Agent header, 403s excluded. browser:* = real or headless browsers; bot:* = declared crawlers; curl/python = scripts. Legend sorted by yesterday's value.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_SOURCE_ID"
      },
      "interval": "1d",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "topk(10, max by (agent) (last_over_time(ohm_cf_agent_requests_daily{blocked=\"no\"}[1d] offset -2d)))",
          "legendFormat": "{{agent}}"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "spanNulls": false,
            "pointSize": 4,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
