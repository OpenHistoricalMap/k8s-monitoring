    {
      "id": 106,
      "type": "timeseries",
      "title": "Share of declared bots",
      "description": "Requests from crawlers that identify themselves (Googlebot, GPTBot, Ahrefs, ClaudeBot...) over all requests. Usually under 1%: the heavy scrapers pretend to be Chrome and cannot be told apart by User-Agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_SOURCE_ID"
      },
      "interval": "1d",
      "gridPos": {
        "x": 18,
        "y": 14,
        "w": 6,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "sum(max by (agent) (last_over_time(ohm_cf_agent_requests_daily{agent=~\"bot:.*\",blocked=\"no\"}[1d] offset -2d))) / sum(max by (agent) (last_over_time(ohm_cf_agent_requests_daily{blocked=\"no\"}[1d] offset -2d)))",
          "legendFormat": "bots"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineWidth": 2,
            "spanNulls": false,
            "pointSize": 4,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#8a8a85"
          },
          "min": 0
        },
        "overrides": []
      }
    },
