{
  "uid": "ohm-traffic-health",
  "title": "OHM traffic health",
  "description": "Blocked requests, errors, cache efficiency and the live tunnel rate. For operations.",
  "tags": [
    "ohm",
    "cloudflare"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "main_host",
        "label": "Main hosts",
        "type": "custom",
        "query": "www,api,vtiles,static-tiles,nominatim,overpass-api,overpass-turbo,tasks,tm-api,taginfo,forum,planet,planet-stats,osmcha,embed,level0",
