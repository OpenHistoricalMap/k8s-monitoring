    {
      "id": 210,
      "type": "timeseries",
      "title": "vtiles requests per day: where they end",
      "description": "Blocked and passed come from the same per-host status breakdown. Cloudflare has no Cache Rule for .pbf, so it serves almost nothing itself; what passes reaches Varnish in the cluster (about 68% hit there) and only Varnish misses reach Martin. Varnish is not visible from Cloudflare.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_SOURCE_ID"
      },
      "interval": "1d",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "sum(max by (status) (last_over_time(ohm_cf_host_status_requests_daily{host=\"vtiles\",status=\"403\"}[1d] offset -2d)))",
          "legendFormat": "blocked by Cloudflare (403)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "sum(max by (cache) (last_over_time(ohm_cf_host_cache_requests_daily{host=\"vtiles\",cache=~\"hit|stale|revalidated\"}[1d] offset -2d)))",
          "legendFormat": "served by Cloudflare cache"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "clamp_min(sum(max by (status) (last_over_time(ohm_cf_host_status_requests_daily{host=\"vtiles\",status!=\"403\"}[1d] offset -2d))) - sum(max by (cache) (last_over_time(ohm_cf_host_cache_requests_daily{host=\"vtiles\",cache=~\"hit|stale|revalidated\"}[1d] offset -2d))), 0)",
          "legendFormat": "passed to the cluster (Varnish, then Martin)"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "spanNulls": false,
            "pointSize": 4,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "blocked by Cloudflare (403)"
            },
            "properties": [
