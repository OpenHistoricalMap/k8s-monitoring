  "panels": [
    {
      "id": 201,
      "type": "row",
      "title": "Right now (hourly from Cloudflare, live from the tunnel)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 202,
      "type": "timeseries",
      "title": "Requests per hour, all hostnames",
      "description": "Previous full hours, UTC.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_SOURCE_ID"
      },
      "interval": "1h",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "last_over_time(ohm_cf_requests_hourly[1h] offset -2h)",
          "legendFormat": "requests"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "spanNulls": false,
            "pointSize": 4,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 203,
      "type": "timeseries",
      "title": "Unique IPs per hour",
      "description": "Hours do not add up: an IP active all day counts in every hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_SOURCE_ID"
      },
      "interval": "1h",
      "gridPos": {
        "x": 8,
