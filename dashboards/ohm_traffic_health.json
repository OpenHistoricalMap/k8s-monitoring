    },
    {
      "id": 204,
      "type": "timeseries",
      "title": "Tunnel requests/s (Hetzner cloudflared)",
      "description": "Live, only the traffic that reaches the Hetzner cluster. Blocked and cached requests never get here.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_SOURCE_ID"
      },
      "interval": "1m",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "sum(rate(cloudflared_tunnel_total_requests[5m]))",
          "legendFormat": "req/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "sum(rate(cloudflared_tunnel_request_errors[5m]))",
          "legendFormat": "errors/s"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineWidth": 2,
            "spanNulls": false,
            "pointSize": 4,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "req/s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "errors/s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c62828"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 205,
      "type": "row",
      "title": "Blocked and errors (per day)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 206,
      "type": "timeseries",
      "title": "Requests per day by response class",
      "description": "403 = WAF or rate-limit rules in Cloudflare. 5xx = the origin failed (Martin, Rails, cgimap).",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_SOURCE_ID"
      },
      "interval": "1d",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "sum(max by (status) (last_over_time(ohm_cf_status_requests_daily{status=~\"2..\"}[1d] offset -2d)))",
          "legendFormat": "2xx ok"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "sum(max by (status) (last_over_time(ohm_cf_status_requests_daily{status=~\"3..\"}[1d] offset -2d)))",
          "legendFormat": "3xx redirect"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "sum(max by (status) (last_over_time(ohm_cf_status_requests_daily{status=\"403\"}[1d] offset -2d)))",
          "legendFormat": "403 blocked by Cloudflare"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "sum(max by (status) (last_over_time(ohm_cf_status_requests_daily{status=\"429\"}[1d] offset -2d)))",
          "legendFormat": "429 rate limited"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "sum(max by (status) (last_over_time(ohm_cf_status_requests_daily{status=~\"4..\",status!~\"403|429\"}[1d] offset -2d)))",
          "legendFormat": "other 4xx"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "sum(max by (status) (last_over_time(ohm_cf_status_requests_daily{status=~\"5..\"}[1d] offset -2d)))",
          "legendFormat": "5xx errors"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "spanNulls": false,
            "pointSize": 4,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#008300"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3xx redirect"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "403 blocked by Cloudflare"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "429 rate limited"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e87ba4"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other 4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eda100"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx errors"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c62828"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 207,
      "type": "timeseries",
      "title": "Share blocked by Cloudflare (403)",
      "description": "On 2026-09-21 this was 58%, almost all on vtiles.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_SOURCE_ID"
      },
      "interval": "1d",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_SOURCE_ID"
          },
          "expr": "sum(max by (status) (last_over_time(ohm_cf_status_requests_daily{status=\"403\"}[1d] offset -2d))) / sum(max by (status) (last_over_time(ohm_cf_status_requests_daily{}[1d] offset -2d)))",
          "legendFormat": "403 share"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineWidth": 2,
