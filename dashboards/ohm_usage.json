{
  "uid": "ohm-usage",
  "title": "OHM usage",
  "description": "How many people use OHM and how much each hostname (subdomain) is used. Source: Cloudflare, via the cloudflare-stats CronJob.",
  "tags": [
    "ohm",
    "cloudflare"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "custom",
        "query": "openhistoricalmap.org,www,api,vtiles,static-tiles,nominatim,overpass-api,overpass-turbo,tasks,tm-api,taginfo,forum,planet,planet-stats,osmcha,embed,level0",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "openhistoricalmap.org",
