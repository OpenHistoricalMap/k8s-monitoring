# Copy to .env and fill in. .env is gitignored — never commit it.

# --- k3s central stack (deploy_k3s.sh) ---
GRAFANA_ADMINPASSWORD=
# Where alert emails go (comma-separated for several recipients)
ALERT_EMAIL_TO=
# AWS SES SMTP credentials (SES console -> SMTP settings -> Create SMTP credentials)
SMTP_USERNAME=
SMTP_PASSWORD=

# --- EKS agent (deploy_eks.sh) ---
# https://prometheus.ohmstaging.org/api/v1/write (staging)
# https://prometheus.openhistoricalmap.org/api/v1/write (production)
REMOTE_WRITE_URL=
# Cloudflare Access service token (Zero Trust -> Access -> Service credentials)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Cloudflare usage stats CronJob (deploy_k3s.sh create / stats) ---
# API token: Cloudflare dashboard -> My Profile -> API Tokens -> permission "Zone / Analytics / Read"
CF_ANALYTICS_API_TOKEN=
# Zone ID: dashboard -> zone Overview -> right column "Zone ID"
# (openhistoricalmap.org for production, ohmstaging.org for staging)
CF_ANALYTICS_ZONE_ID=
# Optional: also keep one JSON per day in S3 (Prometheus keeps 30 days only)
# CF_ANALYTICS_S3_URI=s3://planet.openhistoricalmap.org/cloudflare-stats
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional, Web Analytics (people, bots excluded). Account ID: zone Overview, right column.
# Site tag: Analytics & Logs -> Web Analytics -> the site -> Manage site -> "Site tag".
# The token then also needs "Account / Account Analytics / Read".
# CF_ANALYTICS_ACCOUNT_ID=
# CF_ANALYTICS_RUM_SITE_TAG=
